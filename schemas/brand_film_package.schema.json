{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brand_film_package.schema.json",
  "title": "Final brand-film-spec package",
  "type": "object",
  "required": [
    "package_version",
    "brand_film_spec",
    "summary",
    "creative_brief",
    "category_profile",
    "selected_candidate",
    "score",
    "render_decision",
    "product_fidelity_lock",
    "claim_boundaries",
    "renderer_handoff"
  ],
  "properties": {
    "package_version": {"const": "2.0"},
    "brand_film_spec": {"type": "string"},
    "summary": {"type": "string"},
    "creative_brief": {"type": "object"},
    "category_profile": {"type": "object"},
    "selected_candidate": {"type": "object"},
    "score": {"type": "object"},
    "storyboard_simulation": {"type": ["object", "null"]},
    "render_decision": {"type": "object"},
    "product_fidelity_lock": {"type": "object"},
    "claim_boundaries": {"type": "object"},
    "renderer_handoff": {
      "type": "object",
      "required": ["port_id", "required_inputs", "optional_inputs", "adapter_must_not_rewrite", "return_contract"]
    },
    "manual_upload_notes": {"type": "array", "items": {"type": "string"}}
  }
}
