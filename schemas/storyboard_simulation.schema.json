{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storyboard_simulation.schema.json",
  "title": "Optional image-generation keyframe probe",
  "type": "object",
  "required": ["candidate_id", "profile_id", "keyframes", "storyboard_review"],
  "properties": {
    "candidate_id": {"type": "string"},
    "profile_id": {"type": "string"},
    "keyframes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["keyframe_id", "time", "frame_purpose", "proof_tags", "image_prompt_cn", "image_prompt_en", "negative_prompt", "continuity_notes", "product_fidelity_notes"]
      }
    },
    "storyboard_review": {
      "type": "object",
      "required": ["visual_consistency_risk", "product_fidelity_risk", "category_proof_risk", "model_difficulty", "recommendation"]
    }
  }
}
