{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "product_understanding.schema.json",
  "title": "Codex product understanding artifact",
  "type": "object",
  "required": [
    "schema_version",
    "source_images",
    "product_identity",
    "taxonomy",
    "visual_facts",
    "commercial_hypotheses",
    "truth_boundaries",
    "dense_caption"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "source_images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "role", "source", "observations"],
        "properties": {
          "source_id": {"type": "string"},
          "role": {"enum": ["primary_product", "alternate_angle", "detail_macro", "packaging_or_brand_asset", "reference_mood"]},
          "source": {"type": "string"},
          "observations": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "product_identity": {
      "type": "object",
      "required": ["product_name", "visible_brand_text", "visible_product_text", "variant_or_set"],
      "properties": {
        "product_name": {"type": "string"},
        "visible_brand_text": {"type": "array", "items": {"type": "string"}},
        "visible_product_text": {"type": "array", "items": {"type": "string"}},
        "variant_or_set": {"type": "string"}
      }
    },
    "taxonomy": {"$ref": "#/$defs/taxonomy"},
    "visual_facts": {
      "type": "object",
      "required": ["product_form", "colors", "visible_material_appearance", "packaging", "visible_details", "usage_cues"],
      "properties": {
        "product_form": {"type": "array", "items": {"type": "string"}},
        "colors": {"type": "array", "items": {"type": "string"}},
        "visible_material_appearance": {"type": "array", "items": {"type": "string"}},
        "packaging": {"type": "array", "items": {"type": "string"}},
        "visible_details": {"type": "array", "items": {"type": "string"}},
        "usage_cues": {"type": "array", "items": {"type": "string"}}
      }
    },
    "commercial_hypotheses": {
      "type": "object",
      "required": ["selling_points", "target_audiences", "usage_scenes", "consumer_tensions"],
      "properties": {
        "selling_points": {"type": "array", "items": {"type": "string"}},
        "target_audiences": {"type": "array", "items": {"type": "string"}},
        "usage_scenes": {"type": "array", "items": {"type": "string"}},
        "consumer_tensions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "truth_boundaries": {
      "type": "object",
      "required": ["observed", "inferred", "unknown", "forbidden_inferences"],
      "properties": {
        "observed": {"type": "array", "items": {"type": "string"}},
        "inferred": {"type": "array", "items": {"type": "string"}},
        "unknown": {"type": "array", "items": {"type": "string"}},
        "forbidden_inferences": {"type": "array", "items": {"type": "string"}}
      }
    },
    "dense_caption": {"type": "string", "minLength": 1},
    "category": {"type": "string", "description": "Legacy flattened alias."},
    "sub_category": {"type": "string", "description": "Legacy flattened alias."},
    "product_name": {"type": "string", "description": "Legacy flattened alias."},
    "selling_points": {"type": "array", "items": {"type": "string"}},
    "target_audience": {"type": "string"},
    "distribution_scenarios": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "taxonomy": {
      "type": "object",
      "required": [
        "primary_category",
        "primary_category_id",
        "subcategory",
        "subcategory_id",
        "subcategory_status",
        "subcategory_confidence",
        "subcategory_evidence",
        "subcategory_extension"
      ],
      "properties": {
        "primary_category": {"enum": ["美妆个护", "食品饮料", "服饰配件"]},
        "primary_category_id": {"type": "string"},
        "subcategory": {"type": "string"},
        "subcategory_id": {"type": "string"},
        "subcategory_status": {"enum": ["matched", "provisional", "unresolved", "custom"]},
        "subcategory_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "subcategory_evidence": {"type": "array", "items": {"type": "string"}},
        "subcategory_extension": {
          "type": "object",
          "required": ["candidate_name", "parent_hint", "reason", "future_profile_required", "custom_attributes"],
          "properties": {
            "candidate_name": {"type": "string"},
            "parent_hint": {"type": "string"},
            "reason": {"type": "string"},
            "future_profile_required": {"type": "boolean"},
            "custom_attributes": {"type": "object"}
          }
        }
      }
    }
  }
}
